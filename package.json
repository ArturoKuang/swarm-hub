{
  "name": "swarm-hub",
  "version": "0.1.0",
  "private": true,
  "description": "3-layer distributed agent scheduler and worker pool for Tailscale + OpenMausBot",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "hub": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/hub.ts",
    "worker": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/worker.ts",
    "mcp": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/mcp.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
